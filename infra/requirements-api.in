# Dependances directes de l'image de la passerelle API.
#
# Ce fichier porte les contraintes ; `requirements-api.txt`, genere a partir de
# lui, porte la fermeture complete epinglee -- c'est celui que le Dockerfile
# installe. Ne jamais editer le second a la main.
#
# L'image ne contient ni torch ni transformers : la generation est deleguee au
# serveur vLLM. Elle embarque en revanche Presidio et les modeles spaCy, parce
# que le journal d'audit doit etre anonymise cote service -- c'est le seul
# endroit du systeme ou des donnees patient reelles se deposeraient durablement.
# Ce choix coute environ 400 Mo d'image ; l'alternative, une anonymisation
# degradee dans le conteneur et complete ailleurs, ferait diverger production et
# developpement.
#
# Regenerer apres tout `uv lock` :
#
#   uv export --frozen --no-emit-project --all-groups --no-hashes \
#     --format requirements-txt | grep -E '^[a-zA-Z]' | sed -E 's/\+cu[0-9]+$//' \
#     > /tmp/contraintes.txt
#   uv pip compile infra/requirements-api.in --python-version 3.12 \
#     --python-platform x86_64-unknown-linux-gnu --constraint /tmp/contraintes.txt \
#     --no-header -o infra/requirements-api.txt
#
# La contrainte par le verrou du projet n'est pas un detail : sans elle, la
# resolution de l'image derive de celle du depot, et l'image deployee ne contient
# plus les versions auditees par l'integration continue.

fastapi==0.138.2
uvicorn[standard]==0.49.0
httpx==0.28.1
pydantic==2.13.4
presidio-analyzer==2.2.363
# 2.2.363 verrouille `cryptography` sous la version qui corrige CVE-2026 sur la
# verification de chaines de certificats ; 2.2.362 laisse passer la mise a jour.
# L'operateur de chiffrement de Presidio n'est pas utilise ici, mais une
# dependance vulnerable dans l'image en est une quand meme.
presidio-anonymizer==2.2.362
cryptography==50.0.1
spacy==3.8.13

