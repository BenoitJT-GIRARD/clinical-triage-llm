# Python environments and caches
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Tools
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
# A stray report at the root. The published one lives in `reports/coverage/`, where the header
# badge reads its line rate: a pattern without a slash would match that one too.
/coverage.xml

# IDE
.vscode/
.idea/

# Secrets
.env

# Everything a run produces and nothing tracks: model weights (several gigabytes, published on
# the Hugging Face Hub), the audit log of the service, and the MLflow experiment store. In a
# container the log lives in a named volume instead.
var/

# Training sets: derived from the code and the corpora, rebuilt identically by
# scripts/build_dataset.py (fixed seed) and published on the Hub. The clinical evaluation set
# and metadata.json stay versioned: they are small, and the annotated cases and the
# anonymisation check must be readable without downloading anything.
data/processed/sft_train.jsonl
data/processed/sft_validation.jsonl
data/processed/sft_test.jsonl
data/processed/dpo_train.jsonl

# Caches Unsloth writes at the project root: compiled kernels and temporary buffers, rebuilt at
# every training run.
unsloth_compiled_cache/
_unsloth_temporary_saved_buffers/

# OS leftovers
.DS_Store
Thumbs.db
