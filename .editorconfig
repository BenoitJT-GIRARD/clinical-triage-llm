# Reglages d'edition partages, pour que le depot reste homogene quel que soit
# l'editeur. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Deux espaces en fin de ligne forcent un retour a la ligne en Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
