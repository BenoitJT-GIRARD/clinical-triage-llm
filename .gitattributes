# Line endings are normalised: the repository is written on Windows and continuous integration
# runs on Linux.
* text=auto eol=lf

# Binary files: neither converted nor diffed line by line.
*.png binary
*.jpg binary
*.pdf binary
*.safetensors binary
*.db binary

# The dataset is published with the repository. Marking it generated keeps its differences
# folded by default in reviews, without excluding it from searches.
data/processed/*.jsonl text eol=lf linguist-generated=true

# Notebooks are read as JSON: fixed line endings, and no automatic type detection that would
# make them unreadable in a diff.
*.ipynb text eol=lf linguist-language=Python
