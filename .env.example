# Copier en `.env` et renseigner. Le fichier est lu à l'import de `config.py`,
# et n'écrase jamais une variable déjà posée dans l'environnement : le service,
# les scripts et les tests partent ainsi des mêmes réglages. Il est exclu de git
# et du contexte de construction Docker : ne jamais le committer, ne jamais y
# mettre autre chose que des réglages locaux.
#
# Il ne couvre donc que ce qui passe par le processus Python du projet. Ce qui
# s'exécute avant lui ou à côté de lui l'ignore et lit le shell : `uv` choisit
# l'environnement virtuel avant que Python ne démarre, `docker compose` cherche
# son fichier d'environnement dans `infra/` et non à la racine, et
# `infra/modal_app.py` lit le sien à l'import, avant que le paquet — et donc
# `.env` — ne soit chargé. Ces variables-là sont documentées là où on les
# emploie : README.md pour l'environnement virtuel, deploy/README.md pour la
# pile en conteneurs et pour le déploiement.

# --- Service de triage ---
# Clé d'API attendue en en-tête X-API-Key. Le service refuse de démarrer sans.
TRIAGE_API_KEY=
# Mode ouvert, pour la démonstration locale uniquement.
TRIAGE_ALLOW_ANONYMOUS=false
# Moteur d'inférence : vllm pour le déploiement, transformers pour le local.
TRIAGE_BACKEND=vllm
TRIAGE_VLLM_URL=http://localhost:8000
TRIAGE_VLLM_MODEL=qwen3-1.7b-clinical-triage
# Clé présentée au moteur d'inférence. Vide, c'est TRIAGE_API_KEY qui sert. Le
# moteur n'a ni quota ni journal : dès qu'il est joignable autrement que par la
# boucle locale, il doit réclamer cette clé (vllm serve --api-key).
TRIAGE_VLLM_API_KEY=
# Utilisés uniquement par le moteur transformers.
TRIAGE_BASE_MODEL=models/qwen3-1.7b-triage-sft-merged
TRIAGE_ADAPTER_DIR=models/qwen3-1.7b-triage-dpo
# Version inscrite au journal d'audit, chemin du journal, quota par appelant.
TRIAGE_MODEL_VERSION=qwen3-1.7b-clinical-triage
TRIAGE_AUDIT_LOG=logs/audit_triage.jsonl
TRIAGE_RATE_LIMIT=60

# --- Publication sur le Hugging Face Hub ---
# Jeton d'écriture : https://huggingface.co/settings/tokens
HF_TOKEN=
# Compte sous lequel publier le dataset et les modèles. Le déploiement Modal lit
# le même nom, mais dans le shell : voir deploy/README.md.
HF_NAMESPACE=

# --- Caches et suivi locaux ---
# À placer hors d'un dossier synchronisé : les téléchargements sont volumineux.
HF_HOME=
# Suivi des entraînements. La base SQLite doit elle aussi être hors d'un dossier
# synchronisé : un client qui la recopie pendant l'écriture interrompt la
# création du schéma.
MLFLOW_TRACKING_URI=
