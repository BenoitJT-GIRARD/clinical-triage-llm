# Copy to `.env` and fill in. The file is read when `config.py` is imported, and never
# overwrites a variable already set in the environment: the service, the scripts and the tests
# therefore start from the same settings. It is excluded from git and from the Docker build
# context: never commit it, and never put anything in it but local settings.
#
# It covers what goes through the project's Python process, and that alone. What runs before it
# or beside it ignores the file and reads the shell: `uv` picks the virtual environment before
# Python starts, `docker compose` looks for its environment file in `infra/` rather than at the
# root, and `infra/modal_app.py` reads its own at import time, before the package — and so
# `.env` — is loaded. Those variables are documented where they are used: README.md for the
# virtual environment, infra/README.md for the container stack and for the deployment.

# --- Triage service ---
# API key expected in the X-API-Key header. The service refuses to start without it.
TRIAGE_API_KEY=
# Open mode, for local demonstration only.
TRIAGE_ALLOW_ANONYMOUS=false
# Inference engine: vllm for deployment, transformers for local use.
TRIAGE_BACKEND=vllm
TRIAGE_VLLM_URL=http://localhost:8000
TRIAGE_VLLM_MODEL=qwen3-1.7b-clinical-triage
# Key presented to the inference engine. Left empty, TRIAGE_API_KEY is used instead. The engine
# has neither quota nor audit log: as soon as it is reachable other than through the loopback,
# it must demand this key (vllm serve --api-key).
TRIAGE_VLLM_API_KEY=
# Used by the transformers engine only.
TRIAGE_BASE_MODEL=var/models/qwen3-1.7b-triage-sft-merged
TRIAGE_ADAPTER_DIR=var/models/qwen3-1.7b-triage-dpo
# Version written to the audit log, path of that log, and quota per caller.
TRIAGE_MODEL_VERSION=qwen3-1.7b-clinical-triage
TRIAGE_AUDIT_LOG=var/logs/audit_triage.jsonl
TRIAGE_RATE_LIMIT=60

# --- Container stack (infra/docker-compose.yml) ---
# These four are read by compose, which looks for its environment file in `infra/`: put them
# there rather than here if you run the stack. They are documented here because they are the
# settings of this project, and a reader looking for "which port does it serve on" reads one
# file, not two.
# Ports published on the host, and the folder of weights mounted read-only into the engine.
TRIAGE_API_PORT=8080
TRIAGE_VLLM_PORT=8000
TRIAGE_MODELS_DIR=../var/models
# The engine image, pinned by digest in the compose file. Override it to try another version.
TRIAGE_VLLM_IMAGE=

# --- On-demand deployment (infra/modal_app.py) ---
# Which weights the engine serves, and at which revision. Continuous deployment sets both at
# `modal deploy` time; left empty, the version shipped with the code is used.
TRIAGE_MODEL_ID=
TRIAGE_MODEL_REVISION=

# --- Publishing to the Hugging Face Hub ---
# Write token: https://huggingface.co/settings/tokens
HF_TOKEN=
# Account to publish the dataset and the models under. The Modal deployment reads the same
# name, but from the shell: see infra/README.md.
HF_NAMESPACE=

# --- Local caches and tracking ---
# Put this outside a synchronised folder: the downloads are large. It is read by the Hugging
# Face client rather than by this project's code.
HF_HOME=
# Experiment tracking. The SQLite database must also live outside a synchronised folder: a
# client copying it mid-write interrupts the creation of the schema.
MLFLOW_TRACKING_URI=
